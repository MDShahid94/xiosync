<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  XIOSYNC Worker LaunchDaemon
  Runs the background worker loops (health, warmpool, dispatcher, etc.)
  alongside the XIOSYNC API server.

  Install:
    sudo cp com.xiogrid.xiosync-worker.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.xiogrid.xiosync-worker.plist
    sudo chmod 644 /Library/LaunchDaemons/com.xiogrid.xiosync-worker.plist
    sudo launchctl load /Library/LaunchDaemons/com.xiogrid.xiosync-worker.plist

  Logs: ~/Library/Logs/xiosync-worker.log
  Stop: sudo launchctl unload /Library/LaunchDaemons/com.xiogrid.xiosync-worker.plist
-->
<dict>
  <key>Label</key>
  <string>com.xiogrid.xiosync-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>
      set -e
      LOG=/Users/karmareturns/Library/Logs/xiosync-worker.log
      exec >> $LOG 2>&amp;1
      echo "[$(date -Iseconds)] XIOSYNC Worker starting..."

      # Wait for Postgres
      for i in $(seq 1 30); do
        if /opt/homebrew/bin/pg_isready -h localhost -p 5432 -U xiosync -d xiosync -q 2>/dev/null; then
          echo "[$(date -Iseconds)] Postgres ready"
          break
        fi
        echo "[$(date -Iseconds)] Waiting for Postgres ($i/30)..."
        sleep 3
      done

      # Wait for XIOSYNC API to be up (worker depends on same DB session infra)
      for i in $(seq 1 20); do
        if curl -sf http://localhost:8000/live >/dev/null 2>&amp;1; then
          echo "[$(date -Iseconds)] XIOSYNC API ready"
          break
        fi
        echo "[$(date -Iseconds)] Waiting for XIOSYNC API ($i/20)..."
        sleep 3
      done

      cd /Users/karmareturns/projects/XIOSYNC
      exec /Users/karmareturns/projects/XIOSYNC/.venv/bin/python \
        -m xiosync.worker.main --mode all
    </string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>UserName</key>
  <string>karmareturns</string>

  <key>StandardOutPath</key>
  <string>/Users/karmareturns/Library/Logs/xiosync-worker.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/karmareturns/Library/Logs/xiosync-worker.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/karmareturns/projects/XIOSYNC</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/karmareturns/.local/bin</string>
    <key>HOME</key>
    <string>/Users/karmareturns</string>
    <key>DATABASE_URL</key>
    <string>postgresql+psycopg://xiosync:xiosync@localhost:5432/xiosync</string>
    <key>XIOSYNC_AUTH_SECRET</key>
    <string>xiogrid-mac-mini-1-auth-secret-2026-karma</string>
    <key>XIOSYNC_ENVIRONMENT</key>
    <string>production</string>
    <key>XIOSYNC_LOG_LEVEL</key>
    <string>info</string>
    <key>WORKER_PPPOE_HEALTH_INTERVAL</key>
    <string>60</string>
    <key>WORKER_PPPOE_WARMPOOL_INTERVAL</key>
    <string>120</string>
  </dict>
</dict>
</plist>
