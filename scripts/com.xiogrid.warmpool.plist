<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  XIOSYNC Warm Pool Maintainer — ensures >=5 idle PPPoE slots are always ready
  Runs every 2 minutes. Triggers provisioning if pool falls below WARM_TARGET.
  
  Install:
    cp com.xiogrid.warmpool.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.xiogrid.warmpool.plist
-->
<dict>
  <key>Label</key>
  <string>com.xiogrid.warmpool</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/karmareturns/projects/XIOSYNC/scripts/xio_warmpool_cron.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>XIOSYNC_URL</key>
    <string>http://localhost:8000</string>
    <key>XIOSYNC_ADMIN_EMAIL</key>
    <string>admin@xiogrid.dev</string>
    <key>XIOSYNC_ADMIN_PASS</key>
    <string>Xiogrid2026!Admin</string>
    <key>XIOSYNC_ORG_ID</key>
    <string>00000000-0000-7000-8000-000000000000</string>
    <key>WARM_TARGET</key>
    <string>5</string>
  </dict>

  <!-- Run every 2 minutes -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/xio_warmpool.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/xio_warmpool.log</string>
</dict>
</plist>
